---
import MugenYomuApp from '../components/MugenYomuApp.svelte';
import '../styles/tailwind.css';
import '../styles/themes.css';
import 'katex/dist/katex.min.css';
---

<!doctype html>
<html lang="zh-TW" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MUGEN YOMU (無限閱讀) - AI 科學文獻閱讀工具</title>
    <meta name="description" content="幫助使用者真正讀懂科學文獻與論文原文，而不只是翻譯原文。結合三欄認知空間、長難句語法拆解、變數互動推導與本機 BYOK 隱私架構。" />

    <!-- Early theme initialization to prevent Flash of Unstyled Content (FOUC) -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('mugen_theme') || 'gruvbox-dark';
          document.documentElement.setAttribute('data-theme', saved);
          if (saved === 'gruvbox-light') {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
          } else {
            document.documentElement.classList.remove('light');
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Google Fonts & Material Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <style is:inline>
      @layer base {
        .material-symbols-outlined {
          font-size: 24px;
        }
      }
      .material-symbols-outlined {
        font-size: revert-layer;
      }
    </style>

    <!-- KaTeX Mathematical Typography Stylesheet -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />

  </head>
  <body class="bg-[#1d2021] text-[#ebdbb2] font-sans selection:bg-[#fe8019]/30 selection:text-[#fabd2f]">
    <MugenYomuApp client:load />
  </body>
</html>
